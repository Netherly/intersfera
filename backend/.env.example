# База данных. В Docker хост — db. С хоста машины: localhost и порт 5433.
DATABASE_URL="postgresql://crm:crm@db:5432/intersfera?schema=public"
# Prisma Migrate ходит напрямую, мимо пула. Локально совпадает с DATABASE_URL.
# На Neon — строка без «-pooler» в хосте (её же Vercel называет DATABASE_URL_UNPOOLED).
DIRECT_URL="postgresql://crm:crm@db:5432/intersfera?schema=public"

# Авторизация
JWT_SECRET="intersfera-dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Первый супер-админ (создаётся сидом)
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="admin"
SEED_ADMIN_NAME="Администратор"

# Папка для файлов обращений. В Docker — на volume uploads_data.
UPLOAD_DIR="uploads"

# Сервер внутри контейнера слушает 4000, снаружи опубликован 4001.
PORT=4000
CORS_ORIGIN="http://localhost:5174"

# Почта компании на mail.ru. Хосты и порты — стандартные для mail.ru.
# Адрес ящика и пароль для внешнего приложения вписываются, когда ящик известен.
# Пока они пустые, экран почты показывает пример очереди, а отправка отключена.
# В настройках ящика нужно включить доступ по IMAP.
SMTP_HOST="smtp.mail.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
# Обычно совпадает с SMTP_USER, например: Жилинтерсфера <ящик@mail.ru>
SMTP_FROM=""

# Входящая почта. Письма только показываются, обращения из них сами не создаются.
IMAP_HOST="imap.mail.ru"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_FOLDER="INBOX"
# Если задано, в очередь попадают только письма, в теме которых есть эта строка.
IMAP_SUBJECT=""
